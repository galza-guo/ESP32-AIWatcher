#!/usr/bin/env bash
set -euo pipefail
URL="http://127.0.0.1:7824/"
PATTERN="Desk Monitor"

address_of() {
  hyprctl clients -j | jq -r --arg p "$PATTERN" '.[] | select(.title == $p) | .address' | head -n1
}

shape() {
  local addr="$1"
  [[ -n $addr ]] || return 0
  hyprctl dispatch "hl.dsp.window.float({ action = \"set\", window = \"address:$addr\" })" >/dev/null
  hyprctl dispatch "hl.dsp.window.resize({ x = 400, y = 600, window = \"address:$addr\" })" >/dev/null
}

for _ in $(seq 1 40); do
  if curl -fsS "$URL" >/dev/null 2>&1; then
    break
  fi
  sleep 0.15
done

EXISTING="$(address_of)"
if [[ -n $EXISTING ]]; then
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$EXISTING\" })" >/dev/null 2>&1 \
    || hyprctl dispatch focuswindow "address:$EXISTING" >/dev/null
  shape "$EXISTING"
  exit 0
fi

omarchy-launch-webapp "$URL" >/dev/null 2>&1 &
for _ in $(seq 1 50); do
  ADDR="$(address_of)"
  if [[ -n $ADDR ]]; then
    shape "$ADDR"
    exit 0
  fi
  sleep 0.1
done
exit 0
